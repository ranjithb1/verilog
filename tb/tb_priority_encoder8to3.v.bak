`timescale 1ns/1ps

module tb_priority_encoder_8bit;

reg [7:0] i;
wire [2:0] y;
wire v;

priority_encoder8to3 dut(i, y, v);

initial begin
    $monitor("i=%b  y=%b  v=%b", i, y, v);

    i = 8'b00000000; #10;
    i = 8'b00000001; #10;
    i = 8'b00000010; #10;
    i = 8'b00000100; #10;
    i = 8'b00001000; #10;
    i = 8'b00010000; #10;
    i = 8'b00100000; #10;
    i = 8'b01000000; #10;
    i = 8'b10000000; #10;

    i = 8'b00101101; #10;  // i5 has priority
    i = 8'b10110101; #10;  // i7 has priority
    i = 8'b01110101; #10;  // i6 has priority

    $finish;
end

endmodule